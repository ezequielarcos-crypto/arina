generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./arina.db"
}

// ── Categorías jerárquicas (categoría → subcategoría) ──────────
model Category {
  id        Int        @id @default(autoincrement())
  name      String
  parentId  Int?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryTree")
  sortOrder Int        @default(0)
  active    Boolean    @default(true)
  items     Item[]
}

// ── Item unificado: producto, ingrediente o elaboración ────────
// type: "PRODUCT" (se vende) | "INGREDIENT" (materia prima) | "PREPARATION" (subreceta)
// El costo efectivo es DERIVADO: si el item tiene receta se calcula
// recursivamente desde sus componentes; si no, vale `cost` (manual/última compra).
model Item {
  id          Int     @id @default(autoincrement())
  name        String
  sku         String? @unique
  type        String  @default("PRODUCT")
  unit        String  @default("unidad")
  description String?
  categoryId  Int?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  active   Boolean @default(true)
  favorite Boolean @default(false)

  // Venta
  sellable  Boolean @default(true) // se puede vender individualmente
  available Boolean @default(true) // disponible ahora mismo
  salePrice Float   @default(0)
  taxRate   Float? // % de impuesto, opcional

  // Costo base: manual o de última compra. Ignorado si el item tiene receta.
  cost     Float @default(0)
  wastePct Float @default(0) // merma por defecto (%) al usarlo como componente

  // Stock (los movimientos como fuente de verdad llegan en Fase 2;
  // por ahora todo cambio pasa por endpoints transaccionales)
  trackStock            Boolean @default(false)
  stock                 Float   @default(0)
  minStock              Float   @default(0)
  maxStock              Float?
  allowSaleWithoutStock Boolean @default(true)

  supplierId     Int?
  supplier       Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  lastPurchaseAt DateTime?

  recipe      Recipe?
  usedIn      RecipeItem[] @relation("ComponentUsage")
  purchases   Purchase[]
  saleItems   SaleItem[]
  movements   StockMovement[]
  productions    Production[]
  costHistory    CostHistory[]
  modifierGroups ItemModifierGroup[]
  priceListItems PriceListItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Receta / ficha técnica (cualquier Item puede tener una) ────
model Recipe {
  id        Int          @id @default(autoincrement())
  itemId    Int          @unique
  item      Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  yieldQty  Float        @default(1) // rendimiento: cuántas unidades salen
  yieldUnit String       @default("unidades")
  notes     String?
  items     RecipeItem[]
}

// Línea de receta: referencia a OTRO Item → composición recursiva.
// qty es la cantidad NETA; la bruta se deriva con la merma.
model RecipeItem {
  id          Int    @id @default(autoincrement())
  recipeId    Int
  recipe      Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  componentId Int
  component   Item   @relation("ComponentUsage", fields: [componentId], references: [id], onDelete: Restrict)
  qty         Float
  wastePct    Float? // null → usa la merma por defecto del componente
}

// ── Proveedores ────────────────────────────────────────────────
model Supplier {
  id        Int        @id @default(autoincrement())
  name      String
  phone     String?
  email     String?
  notes     String?
  active    Boolean    @default(true)
  items     Item[]
  purchases Purchase[]
}

// ── Compras de insumos → suma stock, actualiza costo, gasto en Caja
model Purchase {
  id         Int       @id @default(autoincrement())
  itemId     Int
  item       Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  supplierId Int?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  quantity   Float
  totalCost  Float
  date       DateTime  @default(now())
}

// ── Movimientos de stock: la fuente de verdad ──────────────────
// El campo Item.stock es un caché que solo se actualiza junto con un
// movimiento, en la misma transacción. Nunca se modifica en silencio.
// type: PURCHASE | SALE | SALE_CANCEL | CONSUMPTION | PRODUCTION_IN |
//       PRODUCTION_OUT | ADJUST | WASTE | RETURN | INITIAL
model StockMovement {
  id       Int      @id @default(autoincrement())
  itemId   Int
  item     Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type     String
  qty      Float // delta con signo (+entra / −sale)
  date     DateTime @default(now())
  userName String?
  reason   String?
  refType  String? // SALE | PURCHASE | PRODUCTION
  refId    Int?

  @@index([itemId, date])
  @@index([refType, refId])
}

// ── Producción: consume componentes según receta y genera stock ─
model Production {
  id       Int      @id @default(autoincrement())
  itemId   Int
  item     Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  qty      Float // en unidades de rendimiento de la receta
  date     DateTime @default(now())
  userName String?
  notes    String?
}

// ── Historial de costos: nunca se pisa, solo se agrega ─────────
model CostHistory {
  id     Int      @id @default(autoincrement())
  itemId Int
  item   Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  cost   Float
  date   DateTime @default(now())
  source String? // "Compra #12", "Edición manual"

  @@index([itemId, date])
}

// ── Auditoría de cambios importantes ───────────────────────────
model AuditLog {
  id       Int      @id @default(autoincrement())
  entity   String // "Item"
  entityId Int
  field    String
  oldValue String?
  newValue String?
  date     DateTime @default(now())
  userName String?

  @@index([entity, entityId, date])
}

// ── Grupos modificadores (tamaños, adicionales…) ───────────────
model ModifierGroup {
  id         Int                 @id @default(autoincrement())
  name       String // nombre interno
  publicName String? // nombre que ve el cliente
  minQty     Int                 @default(0) // opciones mínimas a elegir
  maxQty     Int                 @default(1) // opciones máximas
  sortOrder  Int                 @default(0)
  active     Boolean             @default(true)
  options    ModifierOption[]
  items      ItemModifierGroup[]
}

model ModifierOption {
  id         Int                @id @default(autoincrement())
  groupId    Int
  group      ModifierGroup      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name       String
  priceDelta Float              @default(0)
  sortOrder  Int                @default(0)
  active     Boolean            @default(true)
  saleUses   SaleItemModifier[]
}

// Asociación item ↔ grupo (un grupo puede usarse en varios items)
model ItemModifierGroup {
  id        Int           @id @default(autoincrement())
  itemId    Int
  item      Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  groupId   Int
  group     ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sortOrder Int           @default(0)

  @@unique([itemId, groupId])
}

// Modificadores elegidos en una línea de venta (snapshot de nombre y precio)
model SaleItemModifier {
  id         Int             @id @default(autoincrement())
  saleItemId Int
  saleItem   SaleItem        @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  optionId   Int?
  option     ModifierOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)
  groupName  String
  optionName String
  priceDelta Float
}

// ── Listas de precios ──────────────────────────────────────────
model PriceList {
  id     Int             @id @default(autoincrement())
  name   String
  active Boolean         @default(true)
  items  PriceListItem[]
  sales  Sale[]
}

model PriceListItem {
  id          Int       @id @default(autoincrement())
  priceListId Int
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  itemId      Int
  item        Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  price       Float

  @@unique([priceListId, itemId])
}

// ── Clientes ───────────────────────────────────────────────────
model Client {
  id          Int      @id @default(autoincrement())
  name        String
  phone       String?
  email       String?
  preferences String?
  sales       Sale[]
  createdAt   DateTime @default(now())
}

// ── Ventas ─────────────────────────────────────────────────────
model Sale {
  id          Int        @id @default(autoincrement())
  date        DateTime   @default(now())
  clientId    Int?
  client      Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  priceListId Int?
  priceList   PriceList? @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  total       Float
  items       SaleItem[]
}

model SaleItem {
  id        Int                @id @default(autoincrement())
  saleId    Int
  sale      Sale               @relation(fields: [saleId], references: [id], onDelete: Cascade)
  itemId    Int
  item      Item               @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantity  Float
  unitPrice Float // precio final por unidad (lista + modificadores)
  modifiers SaleItemModifier[]
}
