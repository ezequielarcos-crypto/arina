{
  "name": "arina-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "setup": "prisma generate && prisma db push --accept-data-loss",
    "bundle": "esbuild dist/index.js --bundle --platform=node --target=node22 --format=cjs --outfile=dist-bundle/server.cjs",
    "package": "yarn build && yarn bundle && pkg dist-bundle/server.cjs --targets node22-linux-x64 --output ../src-tauri/resources/arina-backend && gzip -f ../src-tauri/resources/arina-backend"
  },
  "dependencies": {
    "@prisma/client": "^6.8.2",
    "cors": "^2.8.5",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.0",
    "@yao-pkg/pkg": "^6.21.0",
    "esbuild": "^0.28.1",
    "prisma": "^6.8.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
